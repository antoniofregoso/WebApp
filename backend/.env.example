# Application
APP_NAME=API
APP_VERSION=0.0.1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db
DB_ECHO=false

# Logging
LOG_LEVEL=INFO

# Security / JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_ABSOLUTE_EXPIRE_DAYS=30
USER_LOG_STALE_TIMEOUT_SECONDS=300
USER_LOG_SWEEP_INTERVAL_SECONDS=60
JWT_ISSUER=webapp-api
JWT_AUDIENCE=webapp-client
REFRESH_COOKIE_NAME=refresh_token
REFRESH_CSRF_COOKIE_NAME=refresh_csrf
REFRESH_CSRF_HEADER_NAME=X-CSRF-Token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/graphql

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000"]
CORS_CREDENTIALS=true
CORS_METHODS=["GET", "POST", "OPTIONS"]
CORS_HEADERS=["Authorization", "Content-Type", "X-CSRF-Token"]

# Local attachment filestore
FILESTORE_ROOT=data/filestore
# Defaults to the database name when empty.
FILESTORE_NAMESPACE=
ATTACHMENT_MAX_SIZE_BYTES=26214400
